# Ensure proper MIME type handling for Next.js static assets

# JavaScript files
/_next/static/chunks/*.js  application/javascript; charset=utf-8  200
/_next/static/*.js         application/javascript; charset=utf-8  200

# CSS files
/_next/static/css/*.css   text/css; charset=utf-8               200

# Font files
/_next/static/media/*.woff2  font/woff2                         200

# JSON files
/_next/static/*.json      application/json; charset=utf-8       200

# Add cache control headers
/_next/*                  Cache-Control: public, max-age=31536000, immutable