// This is your Prisma schema file
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  OWNER
  PARTNER
  ASSOCIATE
  STAFF
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(STAFF)
  firm         Firm?     @relation(fields: [firmId], references: [id])
  firmId       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  cases        Case[]
  timeEntries  TimeEntry[]
  documents    Document[]
  messages     Message[]
}

model Firm {
  id          String    @id @default(cuid())
  name        String
  address     String?
  phone       String?
  website     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  users       User[]
  cases       Case[]
  documents   Document[]
}

model Case {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String
  firm        Firm      @relation(fields: [firmId], references: [id])
  firmId      String
  assignedTo  User      @relation(fields: [userId], references: [id])
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  timeEntries TimeEntry[]
  documents   Document[]
  messages    Message[]
}

model TimeEntry {
  id          String    @id @default(cuid())
  description String
  duration    Int       // Duration in minutes
  date        DateTime
  case        Case      @relation(fields: [caseId], references: [id])
  caseId      String
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Document {
  id          String    @id @default(cuid())
  title       String
  content     String
  case        Case      @relation(fields: [caseId], references: [id])
  caseId      String
  firm        Firm      @relation(fields: [firmId], references: [id])
  firmId      String
  createdBy   User      @relation(fields: [userId], references: [id])
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Message {
  id          String    @id @default(cuid())
  content     String
  case        Case      @relation(fields: [caseId], references: [id])
  caseId      String
  sender      User      @relation(fields: [userId], references: [id])
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}